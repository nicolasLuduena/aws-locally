{
  "name": "aws-locally",
  "private": true,
  "version": "1.0.0",
  "description": "A hands-on, DevOps-level AWS course that runs entirely on your machine against AWS Emulator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasLuduena/aws-locally.git"
  },
  "keywords": [
    "aws",
    "devops",
    "course",
    "aws-emulator",
    "terraform",
    "cloudformation",
    "learning"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "node server/index.ts --dev",
    "build": "vite build",
    "start": "vite build && node server/index.ts",
    "verify": "node scripts/verify-labs.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
